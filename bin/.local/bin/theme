#!/usr/bin/env python3
"""One palette for every app: Rex/Ghostty, Neovim, tmux, the session menu, btop, cava.

Palettes live in ~/.config/theme/themes/<id>.json (dotfiles `theme` package). This
script renders each one into ~/.config/theme/build/<id>/ and, on `set`, points
~/.config/theme/active at it and pushes it to the running apps.

  theme list               ids, names and which one is active
  theme set ID             build ID, make it active and apply it everywhere
  theme reset              go back to Kanagawa Dragon (the pre-theme setup)
  theme build [ID...]      render files only (all themes by default)
  theme current            print the active id (empty when on Kanagawa)
  theme show ID            print ID's palette as color swatches

What `set` touches:
  Rex          imports build/ID/ghostty/<Name> into every connected Rex app
               (client.theme.import), which also tints its glass and chrome
  Ghostty      copies the same file to ~/.config/ghostty/themes and rewrites the
               `theme =` line (Ghostty reloads on cmd+shift+, or new windows)
  Neovim       ~/.config/theme/current holds the id; nvims watch it and switch
  tmux         sources build/ID/tmux.conf into a running server
  menus        rex-session-menu / tmux-session-menu read active/menu.sh
  btop, cava   active/btop.theme (linked into ~/.config/btop/themes), active/cava
"""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
ROOT = HOME / ".config/theme"
THEMES = ROOT / "themes"
BUILD = ROOT / "build"
ACTIVE = ROOT / "active"
CURRENT = ROOT / "current"
GHOSTTY_CONFIG = HOME / ".config/ghostty/config"
GHOSTTY_THEMES = HOME / ".config/ghostty/themes"
BTOP_THEMES = HOME / ".config/btop/themes"
BTOP_CONF = HOME / ".config/btop/btop.conf"
CAVA_CONF = HOME / ".config/cava/config"
KANAGAWA = {"ghostty": "Kanagawa Dragon", "rex": "merino-dark", "btop": "kanagawa-dragon"}
os.environ["PATH"] = "/opt/homebrew/bin:" + str(HOME / ".local/bin") + ":" + os.environ.get("PATH", "")


def load(tid):
    path = THEMES / f"{tid}.json"
    if not path.exists():
        sys.exit(f"theme: no palette {path}")
    return json.loads(path.read_text())


def ids():
    return sorted(p.stem for p in THEMES.glob("*.json"))


def rgb(c):
    return int(c[1:3], 16), int(c[3:5], 16), int(c[5:7], 16)


def blend(a, b, t):
    (ar, ag, ab), (br, bg, bb) = rgb(a), rgb(b)
    return "#%02x%02x%02x" % (round(ar * t + br * (1 - t)), round(ag * t + bg * (1 - t)), round(ab * t + bb * (1 - t)))


def semi(c):
    return "%d;%d;%d" % rgb(c)


# --- renderers -----------------------------------------------------------------------

def ghostty(t):
    u, a = t["ui"], t["ansi"]
    lines = [f"# {t['name']}: {t['tagline']}", f"# Generated by ~/.local/bin/theme from ~/.config/theme/themes/{t['id']}.json"]
    lines += [f"palette = {i}={c}" for i, c in enumerate(a)]
    lines += [
        f"background = {u['bg']}",
        f"foreground = {u['fg']}",
        f"cursor-color = {u['cursor']}",
        f"cursor-text = {u['bg']}",
        f"selection-background = {u['selection']}",
        f"selection-foreground = {u['fg_bright']}",
        f"split-divider-color = {u['border']}",
    ]
    return "\n".join(lines) + "\n"


def menu_sh(t):
    """Colors for the fzf session menus (rex-session-menu, tmux-session-menu)."""
    u, s, d = t["ui"], t["syntax"], t["diag"]
    fzf = (
        f"fg:{u['fg']},bg:-1,hl:{u['accent']},fg+:{u['fg_bright']},bg+:{u['surface_hi']},hl+:{u['accent']},"
        f"info:{u['fg_dim']},prompt:{u['accent']},pointer:{u['accent']},marker:{s['string']},"
        f"spinner:{u['accent']},border:{u['border']},header:{u['fg_dim']},separator:{u['border']},"
        f"scrollbar:{u['surface_hi']},gutter:-1,query:{u['fg_bright']},preview-border:{u['border']}"
    )
    out = {
        "THEME_ID": t["id"],
        "THEME_FZF_COLORS": fzf,
        # r;g;b triplets for the menu rows (passed into the rex Lua as args)
        "THEME_RGB_ACCENT": semi(u["accent"]),
        "THEME_RGB_FG": semi(u["fg"]),
        "THEME_RGB_DIR": semi(u["fg_dim"]),
        "THEME_RGB_DIM": semi(u["border"]),
        "THEME_RGB_HEAD": semi(u["fg_dim"]),
        "THEME_RGB_OK": semi(d["ok"]),
        "THEME_RGB_WARN": semi(d["warn"]),
        "THEME_RGB_ERROR": semi(d["error"]),
    }
    return "".join(f"export {k}='{v}'\n" for k, v in out.items())


def tmux(t):
    """Sets the @th_* options .tmux.conf's formats use, plus the plain style options."""
    u, s, d = t["ui"], t["syntax"], t["diag"]
    opts = {
        "@th_fg": u["fg"], "@th_dim": u["fg_dim"], "@th_session": u["accent"], "@th_sep": u["border"], "@th_accent": u["accent"],
        "@th_prefix": s["keyword"], "@th_ok": d["ok"], "@th_warn": d["warn"], "@th_path": s["string"],
        "@th_branch": s["field"], "@th_host": u["fg_dim"], "@th_clock": s["keyword"], "@th_border": u["border_hi"],
        "@th_active": u["accent"],
    }
    lines = [f"# Generated by ~/.local/bin/theme ({t['name']})"]
    lines += [f'set -g {k} "{v}"' for k, v in opts.items()]
    lines += [
        f'setw -g window-status-style "fg={u["fg"]},bg=default,none"',
        f'setw -g window-status-activity-style "fg={u["fg"]},bg=default,none"',
        f'set -g message-style "fg={s["keyword"]},bg=default,align=centre"',
        f'set -g message-command-style "fg={s["keyword"]},bg=default,align=centre"',
        f'set -g pane-border-style "fg={u["border"]}"',
        f'set -g pane-active-border-style "fg={u["accent"]}"',
        f'set -g popup-border-style "fg={u["border_hi"]}"',
        f'set -g mode-style "fg={u["fg_bright"]},bg={u["selection"]}"',
        f'set -g copy-mode-match-style "fg={u["fg_bright"]},bg={blend(u["accent"], u["bg"], 0.35)}"',
        f'set -g copy-mode-current-match-style "fg={u["bg"]},bg={u["accent"]}"',
    ]
    return "\n".join(lines) + "\n"


def btop(t):
    u, s, d = t["ui"], t["syntax"], t["diag"]
    c = {
        "main_bg": "", "main_fg": u["fg"], "title": u["fg_bright"], "hi_fg": u["accent"],
        "selected_bg": u["surface_hi"], "selected_fg": u["fg_bright"], "inactive_fg": u["linenr"],
        "graph_text": u["fg_dim"], "meter_bg": u["surface"], "proc_misc": s["number"],
        "cpu_box": u["border"], "mem_box": u["border"], "net_box": u["border"], "proc_box": u["border"],
        "div_line": u["border"],
        "temp_start": s["string"], "temp_mid": d["warn"], "temp_end": d["error"],
        "cpu_start": s["number"], "cpu_mid": u["accent"], "cpu_end": s["field"],
        "free_start": s["string"], "free_mid": s["string"], "free_end": s["string"],
        "cached_start": s["number"], "cached_mid": s["number"], "cached_end": s["number"],
        "available_start": u["accent"], "available_mid": u["accent"], "available_end": u["accent"],
        "used_start": s["keyword"], "used_mid": s["keyword"], "used_end": d["error"],
        "download_start": u["accent"], "download_mid": s["number"], "download_end": s["string"],
        "upload_start": s["field"], "upload_mid": s["keyword"], "upload_end": d["warn"],
        "process_start": s["string"], "process_mid": d["warn"], "process_end": d["error"],
    }
    return f"# {t['name']} (generated by ~/.local/bin/theme)\n" + "".join(f'theme[{k}]="{v}"\n' for k, v in c.items())


def cava(t):
    """The user's cava config with the gradient swapped for this palette's colors."""
    s, u, d = t["syntax"], t["ui"], t["diag"]
    grad = [u["accent"], s["func"], s["number"], s["string"], s["meta"], s["keyword"], d["error"]]
    base = CAVA_CONF.read_text() if CAVA_CONF.exists() else "[color]\ngradient = 1\n"
    base = re.sub(r"(?m)^gradient_color_\d+ = .*\n", "", base)
    base = re.sub(r"(?m)^gradient_count = .*\n", "", base)
    lines = [f"gradient_count = {len(grad)}"] + [f"gradient_color_{i + 1} = '{c}'" for i, c in enumerate(grad)]
    return re.sub(r"(?m)^gradient = 1\n", "gradient = 1\n" + "\n".join(lines) + "\n", base, count=1)


def build(tid):
    t = load(tid)
    out = BUILD / tid
    (out / "ghostty").mkdir(parents=True, exist_ok=True)
    (out / "ghostty" / t["name"]).write_text(ghostty(t))
    (out / "menu.sh").write_text(menu_sh(t))
    (out / "tmux.conf").write_text(tmux(t))
    (out / "btop.theme").write_text(btop(t))
    (out / "cava").write_text(cava(t))
    (out / "name").write_text(t["name"] + "\n")
    return t, out


# --- applying ------------------------------------------------------------------------

def run(*cmd, quiet=True):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        if not quiet:
            print(f"  {cmd[0]}: {e}")
        return None


def rex_apps():
    r = run("rex", "client", "ls", "--json")
    if not r or r.returncode:
        return []
    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return []
    rows = data.get("clients", data) if isinstance(data, dict) else data
    return [c.get("client_id") or c.get("id") for c in rows if c.get("kind") == "app"]


def apply_rex(ghostty_file=None, builtin=None):
    done = 0
    for cid in rex_apps():
        if ghostty_file:
            r = run("rex", "-C", cid, "do", "client.theme.import", f"path={ghostty_file}")
        else:
            r = run("rex", "-C", cid, "do", "client.setting.themes.dark.palette", f"value={builtin}")
        if r and r.returncode == 0:
            done += 1
        elif r:
            print(f"  rex: {cid}: {(r.stderr or r.stdout).strip()[:200]}")
    print(f"  rex: {done} app(s)")


def apply_ghostty(name, src=None):
    if src:
        GHOSTTY_THEMES.mkdir(parents=True, exist_ok=True)
        shutil.copy(src, GHOSTTY_THEMES / name)
    if GHOSTTY_CONFIG.exists():
        cfg = GHOSTTY_CONFIG.resolve()
        text = cfg.read_text()
        new = re.sub(r"(?m)^theme = .*$", f"theme = {name}", text)
        if new != text:
            cfg.write_text(new)
    print(f"  ghostty: theme = {name} (reload with cmd+shift+,)")


def apply_tmux(conf):
    if run("tmux", "info") is None:
        return
    r = run("tmux", "source-file", str(conf))
    if r and r.returncode == 0:
        print("  tmux: sourced")


def apply_btop(theme_file):
    BTOP_THEMES.mkdir(parents=True, exist_ok=True)
    link = BTOP_THEMES / "theme-active.theme"
    if link.is_symlink() or link.exists():
        link.unlink()
    if theme_file:
        link.symlink_to(theme_file)
    want = "theme-active" if theme_file else KANAGAWA["btop"]
    if BTOP_CONF.exists():
        cfg = BTOP_CONF.resolve()
        text = cfg.read_text()
        new = re.sub(r'(?m)^color_theme = ".*"$', f'color_theme = "{want}"', text)
        if new != text:
            cfg.write_text(new)
    print(f"  btop: {want} (applies on next start)")


def set_active(target):
    if ACTIVE.is_symlink() or ACTIVE.exists():
        ACTIVE.unlink()
    if target:
        ACTIVE.symlink_to(target)


def cmd_set(tid):
    t, out = build(tid)
    set_active(out)
    tmp = CURRENT.with_suffix(".tmp")
    tmp.write_text(tid + "\n")
    tmp.replace(CURRENT)  # nvims watch the directory for this rename
    print(f"{t['name']}:")
    print("  nvim: running instances switch now")
    gfile = out / "ghostty" / t["name"]
    apply_rex(ghostty_file=gfile)
    apply_ghostty(t["name"], gfile)
    apply_tmux(out / "tmux.conf")
    apply_btop(out / "btop.theme")


def cmd_reset():
    if CURRENT.exists():
        CURRENT.unlink()
    set_active(None)
    print("Kanagawa Dragon:")
    apply_rex(builtin=KANAGAWA["rex"])
    apply_ghostty(KANAGAWA["ghostty"])
    apply_btop(None)
    print("  tmux: reload ~/.tmux.conf (prefix r) to get the Kanagawa colors back")


def cmd_list():
    cur = CURRENT.read_text().strip() if CURRENT.exists() else ""
    for tid in ids():
        t = load(tid)
        mark = "●" if tid == cur else " "
        print(f"{mark} {tid:<15} {t['name']:<14} {t['tagline']}")
    if not cur:
        print("  (active: Kanagawa Dragon, the pre-theme setup)")


def cmd_show(tid):
    t = load(tid)
    def sw(c, label):
        r, g, b = rgb(c)
        return f"\033[48;2;{r};{g};{b}m    \033[0m \033[38;2;{r};{g};{b}m{label:<13}{c}\033[0m"
    print(f"{t['name']} — {t['tagline']}\n")
    for group in ("ui", "syntax", "diag", "git"):
        items = list(t[group].items())
        print(group)
        for i in range(0, len(items), 3):
            print("  " + "   ".join(sw(c, k) for k, c in items[i:i + 3]))
    print("ansi")
    print("  " + "".join(f"\033[48;2;{';'.join(map(str, rgb(c)))}m   " for c in t["ansi"][:8]) + "\033[0m")
    print("  " + "".join(f"\033[48;2;{';'.join(map(str, rgb(c)))}m   " for c in t["ansi"][8:]) + "\033[0m")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "set" and len(rest) == 1:
        cmd_set(rest[0])
    elif cmd == "reset":
        cmd_reset()
    elif cmd == "build":
        for tid in rest or ids():
            _, out = build(tid)
            print(out)
    elif cmd == "current":
        print(CURRENT.read_text().strip() if CURRENT.exists() else "")
    elif cmd == "show" and len(rest) == 1:
        cmd_show(rest[0])
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
