#!/bin/sh
# Runs gitleaks on the staged changes and exits non-zero, blocking the commit,
# when it finds something that looks like a secret. gitleaks picks up the repo's
# own .gitleaks.toml if it has one. Called by the global pre-commit hook
# (~/.config/git/hooks), ~/.huskyrc, and repo hooks that bypass the global path.
#
# A false positive: put a `gitleaks:allow` comment on that line, or skip the scan
# once with `git commit --no-verify` (which skips the repo's own hooks too).

# GUI git clients (PhpStorm, GitHub Desktop) can run hooks without Homebrew on PATH
PATH="$PATH:/opt/homebrew/bin"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "secret-scan: gitleaks is not installed (brew install gitleaks); commit not scanned" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --verbose --no-banner --log-level warn
