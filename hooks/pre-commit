#!/bin/sh
# Blocks a commit that stages anything gitleaks recognizes as a secret.
# Enabled per clone with: git config core.hooksPath hooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); refusing to commit unscanned" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
