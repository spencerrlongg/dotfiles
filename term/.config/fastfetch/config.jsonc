// fastfetch: system info beside a pixel-art Great Wave, in Kanagawa Dragon colors.
// The logo comes from make-logo.py; regenerate with `python3 make-logo.py > great-wave.ans`.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/great-wave.ans",
    "width": 34,
    "height": 16,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;126;156;216",     // crystalBlue #7e9cd8
      "title": "38;2;196;116;110",    // dragonRed   #c4746e
      "output": "38;2;197;201;197"    // dragonWhite #c5c9c5
    },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;98;94;90m─────────────────────────────" },
    { "type": "os", "key": "󰀵 os" },
    { "type": "host", "key": "󰌢 host" },
    { "type": "kernel", "key": " kernel" },
    { "type": "uptime", "key": "󰅐 uptime" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "shell", "key": " shell" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu", "key": " cpu" },
    { "type": "memory", "key": " mem" },
    { "type": "disk", "key": "󰋊 disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
